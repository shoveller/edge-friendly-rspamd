{
  "name": "edge-friendly-rspamd",
  "version": "0.1.0",
  "description": "Cloudflare-edge deterministic mail firewall inspired by Rspamd scoring principles.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoveller/edge-friendly-rspamd.git"
  },
  "bugs": {
    "url": "https://github.com/shoveller/edge-friendly-rspamd/issues"
  },
  "homepage": "https://github.com/shoveller/edge-friendly-rspamd#readme",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "npm run cf-typegen && tsc -b",
    "format": "prettier .",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format -- --check && npm run test && npm run build",
    "prepare": "husky"
  },
  "keywords": [
    "cloudflare",
    "email-routing",
    "hono",
    "rspamd",
    "spam-filtering",
    "mail-firewall"
  ],
  "dependencies": {
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.3.5",
    "vite-ssr-components": "^0.6.1",
    "vitest": "^4.1.5",
    "wrangler": "4.4.0"
  }
}
